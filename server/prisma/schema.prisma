generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  discordId   String   @unique
  username    String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  inventory    InventoryItem[]
  pokemonUnits PokemonUnit[]
  refugeSlots  RefugeSlot[]
  runs         Run[]
}

/// Frugal duplicate-tracking: one row per (user, resource), quantity incremented in place.
model InventoryItem {
  id       String @id @default(uuid())
  userId   String
  resource String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

/// One row per (user, species) — duplicates increment `quantity` instead of new rows.
model PokemonUnit {
  id             String   @id @default(uuid())
  userId         String
  speciesId      String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refugeSlot RefugeSlot?

  @@unique([userId, speciesId])
}

model RefugeSlot {
  id              String   @id @default(uuid())
  userId          String
  slotType        String
  pokemonUnitId   String?  @unique
  lastCollectedAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemonUnit PokemonUnit? @relation(fields: [pokemonUnitId], references: [id], onDelete: SetNull)

  @@unique([userId, slotType])
}

/// One roguelite expedition. The whole thing is a seed plus the path taken, so
/// a run costs one row and the server can regenerate any node to check a claim.
model Run {
  id        String    @id @default(uuid())
  userId    String
  status    String    @default("active")
  /// Serialised RunState from @pokerancher/shared.
  state     Json
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
