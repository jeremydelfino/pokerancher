generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  discordId   String   @unique
  username    String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  inventory    InventoryItem[]
  pokemonUnits PokemonUnit[]
  refugeSlots  RefugeSlot[]
  runs         Run[]
  stageClears  StageClear[]
}

/// Frugal duplicate-tracking: one row per (user, resource), quantity incremented in place.
model InventoryItem {
  id       String @id @default(uuid())
  userId   String
  resource String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

/// One row per (user, species) — duplicates increment `quantity` instead of new rows.
model PokemonUnit {
  id             String   @id @default(uuid())
  userId         String
  speciesId      String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refugeWork RefugeAssignment?

  @@unique([userId, speciesId])
}

model RefugeSlot {
  id              String   @id @default(uuid())
  userId          String
  slotType        String
  lastCollectedAt DateTime @default(now())
  /// Pen upgrade level bought with coins. 0 is the pen as built, and the level
  /// is what caps how many workers the pen may hold.
  level           Int      @default(0)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workers RefugeAssignment[]

  @@unique([userId, slotType])
}

/// One Pokemon working one pen. A pen holds as many of these as its level
/// allows; the unique on pokemonUnitId is what stops the same Pokemon working
/// two pens at once — and, with the run check in refugeService, two jobs at once.
model RefugeAssignment {
  id            String @id @default(uuid())
  slotId        String
  pokemonUnitId String @unique
  /// Position in the pen, 0-based. Drives the occupant weighting.
  seat          Int    @default(0)

  slot        RefugeSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  pokemonUnit PokemonUnit @relation(fields: [pokemonUnitId], references: [id], onDelete: Cascade)

  @@unique([slotId, seat])
}

/// One roguelite expedition. The whole thing is a seed plus the path taken, so
/// a run costs one row and the server can regenerate any node to check a claim.
model Run {
  id        String    @id @default(uuid())
  userId    String
  status    String    @default("active")
  /// Serialised RunState from @pokerancher/shared.
  state     Json
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// One row per expedition a player has beaten. Presence is the whole record —
/// a stage is either cleared or it is not, and the next one unlocks from that.
model StageClear {
  id        String   @id @default(uuid())
  userId    String
  stageId   String
  clearedAt DateTime @default(now())
  /// Best (lowest) number of nodes it took, for the selection screen.
  bestDepth Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
}
