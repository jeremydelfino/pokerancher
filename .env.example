# --- Server ---
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Supabase / Neon in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/pokerancher"

# Session JWT signing secret (generate a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Discord OAuth2 app (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:4000/auth/discord/callback"

# Where the browser is sent back to after login, and what origin the API accepts cookies/CORS from
CLIENT_URL="http://localhost:5173"

# --- Client (Vite) ---
VITE_API_URL="http://localhost:4000"
